<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding — Figma 01 (light + dark via ob_* colors) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ob_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="ScrollTrack logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ScrollTrack"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ob_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ob_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Skip"
                android:textSize="15sp"
                android:textColor="@color/ob_sub" />
        </LinearLayout>

        <!-- Hero illustration -->
        <com.hatch.reeltracker.HeroRingView
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="26dp" />

        <!-- Headline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Less scrolling.\nMore living."
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ob_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Make room for what matters with gentle goals\nand a little daily encouragement."
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ob_sub" />

        <!-- Feature rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/chip_tint"
                android:padding="12dp"
                android:src="@drawable/ic_chart"
                android:contentDescription="chart icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="See your screen time &amp; reels clearly"
                android:textSize="15sp"
                android:textColor="@color/ob_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/chip_tint"
                android:padding="12dp"
                android:src="@drawable/ic_leaf"
                android:contentDescription="leaf icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Build small habits that feel good"
                android:textSize="15sp"
                android:textColor="@color/ob_text" />
        </LinearLayout>

        <!-- Page dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="8dp"
                android:src="@drawable/ob_dot_active" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ob_dot" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ob_dot" />
        </LinearLayout>

        <!-- CTA -->
        <Button
            android:id="@+id/ob_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/btn_primary"
            android:text="→  Let's get started"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Privacy note -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="shield icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Your habits are yours. Your data stays private."
                android:textSize="12sp"
                android:textColor="@color/ob_sub" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

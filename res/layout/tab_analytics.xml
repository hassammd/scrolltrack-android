<?xml version="1.0" encoding="utf-8"?>
<!-- Insights tab — Figma 03 (light + dark via td_* colors) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/td_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insights"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/td_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="A clearer picture of your habits."
                android:textSize="15sp"
                android:textColor="@color/td_sub" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_calendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_td"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar_new"
                android:contentDescription="calendar" />
        </FrameLayout>
    </LinearLayout>

    <!-- Day / Week / Month with period navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_an_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_td"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="previous period" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:background="@drawable/nav_pill"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Day"
                android:textSize="14sp"
                android:textColor="@color/td_sub" />

            <TextView
                android:id="@+id/seg_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Week"
                android:textSize="14sp"
                android:textColor="@color/td_sub" />

            <TextView
                android:id="@+id/seg_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Month"
                android:textSize="14sp"
                android:textColor="@color/td_sub" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_an_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_td"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="next period" />
    </LinearLayout>

    <!-- Chart card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/card_td"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_an_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily average · Oct 5–11"
                    android:textSize="15sp"
                    android:textColor="@color/td_sub" />

                <TextView
                    android:id="@+id/tv_an_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1h 48m"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="@color/td_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_an_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_track"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="↓ 18%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/td_pill_text" />
        </LinearLayout>

        <com.hatch.reeltracker.BarsView
            android:id="@+id/chart_analytics"
            android:layout_width="match_parent"
            android:layout_height="195dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/legend_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_reels" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Reels"
                android:textSize="12sp"
                android:textColor="@color/td_sub" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/dot_other_time" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Other time"
                android:textSize="12sp"
                android:textColor="@color/td_sub" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_an_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="24 minutes less each day than last week."
            android:textSize="13sp"
            android:textColor="@color/td_sub" />
    </LinearLayout>

    <!-- App breakdown card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/card_td"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App breakdown"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/td_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_breakdown_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textSize="14sp"
                    android:textColor="@color/td_sub" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.7"
                android:text="App"
                android:textSize="12sp"
                android:textColor="@color/td_sub" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Time"
                android:textSize="12sp"
                android:textColor="@color/td_sub" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Reels"
                android:textSize="12sp"
                android:textColor="@color/td_sub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/td_nav_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/footer_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_other_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Other apps · 14m"
                android:textSize="13sp"
                android:textColor="@color/td_sub" />

            <TextView
                android:id="@+id/tv_totals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="84 reels · 41m total"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/td_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_shield_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Your data stays on your phone."
            android:textSize="13sp"
            android:textColor="@color/td_sub" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom nav — redesign: floating white pill, calendar / bars / shield / person -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="14dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/nav_pill"
        android:elevation="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/nav_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_today_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_today" />

            <TextView
                android:id="@+id/nav_today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Today"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_insights"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_insights_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_insights" />

            <TextView
                android:id="@+id/nav_insights_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Insights"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_limits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_limits_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_limits" />

            <TextView
                android:id="@+id/nav_limits_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Limits"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_you"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_you_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_you" />

            <TextView
                android:id="@+id/nav_you_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="You"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>

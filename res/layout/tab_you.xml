<?xml version="1.0" encoding="utf-8"?>
<!-- You tab — temporary native screen until the Figma design arrives -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/td_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/td_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Your journey, at a glance."
        android:textSize="13sp"
        android:textColor="@color/td_sub" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:background="@drawable/card_td"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_flame"
                android:contentDescription="flame" />

            <TextView
                android:id="@+id/tv_you_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Start your streak"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/td_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_you_streak_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Every clean day will grow your flame. Keep showing up."
            android:textSize="13sp"
            android:textColor="@color/td_sub" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/card_td"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScrollTrack"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/td_text" />

        <TextView
            android:id="@+id/tv_you_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ScrollTrack · Made to beat scrolling addiction."
            android:textSize="13sp"
            android:textColor="@color/td_sub" />

        <Button
            android:id="@+id/btn_you_diag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="Diagnostics"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>
